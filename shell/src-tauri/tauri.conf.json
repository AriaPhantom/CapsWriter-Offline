{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsWriter Shell",
  "version": "1.0.0",
  "identifier": "com.capswriter.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:6021",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
